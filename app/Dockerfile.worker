# Build stage: dotnet SDK, compiles and publishes
FROM dhi.io/dotnet:10-sdk AS build
WORKDIR /src

# Copy csproj and restore as distinct layers
COPY src/Hba.Contracts/Hba.Contracts.csproj src/Hba.Contracts/
COPY src/Hba.Processing/Hba.Processing.csproj src/Hba.Processing/
COPY src/Hba.Worker/Hba.Worker.csproj src/Hba.Worker/
RUN dotnet restore src/Hba.Worker/Hba.Worker.csproj

# Copy everything else and build
COPY src/ src/
RUN dotnet publish src/Hba.Worker/Hba.Worker.csproj -c Release -o /out --no-restore

# Final runtime stage (rootless)
FROM dhi.io/aspnetcore:10 AS final
WORKDIR /app
COPY --from=build /out ./
# DHI runtime images run as the non-root user 65532 and don't define APP_UID (only Microsoft's
# images do), so USER $APP_UID would expand to nothing and the container would run as root.
USER 65532
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD ["dotnet", "Hba.Worker.dll", "--healthcheck"]
ENTRYPOINT ["dotnet", "Hba.Worker.dll"]
