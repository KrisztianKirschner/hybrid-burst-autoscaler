# https://prometheus.io/docs/prometheus/latest/configuration/configuration/
# https://github.com/prometheus/prometheus/blob/release-3.15/config/testdata/conf.good.yml
global:
  scrape_interval: {{ observability_scrape_interval }}
  evaluation_interval: {{ observability_scrape_interval }}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  # node_exporter on every inventory host; a new Terraform VM is picked up on the next Ansible run
  - job_name: node
    static_configs:
{% for host in groups['all'] | sort %}
      - targets: ["{{ hostvars[host]['ansible_host'] | default(host) }}:{{ observability_node_exporter_port }}"]
        labels:
          instance: "{{ host }}"
          cluster: "{{ hostvars[host]['cluster'] | default('none') }}"
          node_role: "{{ hostvars[host]['node_role'] | default('none') }}"
{% endfor %}
