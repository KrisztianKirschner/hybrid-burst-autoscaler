name: observability

services:
  prometheus:
    # https://prometheus.io/docs/prometheus/latest/installation/
    # https://prometheus.io/docs/prometheus/latest/storage/
    image: "{{ observability_prometheus_image }}"
    restart: unless-stopped
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ observability_retention_time }}
      - --storage.tsdb.retention.size={{ observability_retention_size }}
    ports:
      - "{{ observability_prometheus_port }}:9090"
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus

  grafana:
    # https://grafana.com/docs/grafana/latest/setup-grafana/installation/docker/
    # https://grafana.com/docs/grafana/latest/setup-grafana/configure-grafana/
    image: "{{ observability_grafana_image }}"
    restart: unless-stopped
    depends_on:
      - prometheus
    ports:
      - "{{ observability_grafana_port }}:3000"
    environment:
      GF_SECURITY_ADMIN_USER: admin
      # Read only when Grafana first creates its DB
      GF_SECURITY_ADMIN_PASSWORD__FILE: /run/secrets/grafana_admin_password
      GF_USERS_ALLOW_SIGN_UP: "false"
    secrets:
      - grafana_admin_password
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - ./grafana/dashboards:/etc/grafana/dashboards:ro
      - grafana-data:/var/lib/grafana

secrets:
  grafana_admin_password:
    file: ./secrets/grafana_admin_password

# Named volumes: prevent data loss when the container is removed
volumes:
  prometheus-data:
  grafana-data:
